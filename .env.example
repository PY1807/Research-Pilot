# Copy to .env for running the backend outside Docker. Never commit .env.
# docker compose sets these itself, so a .env is optional for `make up`.

ENV=development
DATABASE_URL=postgresql+asyncpg://researchpilot:researchpilot@localhost:5433/researchpilot
TEST_DATABASE_URL=postgresql+asyncpg://researchpilot:researchpilot@localhost:5433/researchpilot_test
DEV_USER_EMAIL=dev@researchpilot.local

# Added in later milestones:
REDIS_URL=redis://localhost:6379/0
STORAGE_DIR=storage
# LLM_PROVIDER=         (M4)
# LLM_API_KEY=          (M4)
