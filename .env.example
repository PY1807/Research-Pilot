# Copy to .env for running the backend outside Docker. Never commit .env.
# docker compose sets these itself, so a .env is optional for `make up`.

ENV=development
DATABASE_URL=postgresql+asyncpg://researchpilot:researchpilot@localhost:5433/researchpilot
TEST_DATABASE_URL=postgresql+asyncpg://researchpilot:researchpilot@localhost:5433/researchpilot_test
DEV_USER_EMAIL=dev@researchpilot.local

# Added in later milestones:
REDIS_URL=redis://localhost:6379/0
STORAGE_DIR=storage

# LLMs (M4). docker compose reads this file, so for `make up` these are the only lines
# you need in .env. Providers without a key are skipped.
# Gemini: free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash
# xAI Grok (paid per token): https://console.x.ai
GROK_API_KEY=
# GROK_MODEL=grok-3-mini
# Groq (free tier, open models): https://console.groq.com/keys
GROQ_API_KEY=
# GROQ_MODEL=openai/gpt-oss-120b
# Order to try providers in. The judge prefers a different model from the answerer.
# LLM_ANSWER_PROVIDERS=gemini,grok,groq
# LLM_JUDGE_PROVIDERS=grok,groq,gemini
